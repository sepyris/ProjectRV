%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd4a7bb44dcbbb048a90049041640f86, type: 3}
  m_Name: DialogueDatabase
  m_EditorClassIdentifier: 
  Items:
  - npcId: npc_0001
    dialogueType: Normal
    questId: 
    lines:
    - Text: "\uBC18\uAC00\uC6CC\uC694! \uD330\uB9AC\uC2A4\uD0C0\uC6B4\uC758 \uB300\uD45C,
        \uB8E8\uB8E8\uC785\uB2C8\uB2E4!"
  - npcId: npc_0001
    dialogueType: Daily
    questId: 
    lines:
    - Text: "\uC6B0\uB9AC \uB9C8\uC744\uC5D0\uC11C \uC990\uAC70\uC6B4 \uCD94\uC5B5
        \uB9CE\uC774 \uB9CC\uB4DC\uC2DC\uAE38 \uBC14\uB784\uAC8C\uC694!"
  - npcId: npc_0001
    dialogueType: Quest_Offer
    questId: Quest_001
    lines:
    - Text: "\uC0C8\uB85C \uC628 \uC774\uBC29\uC778 \uC774\uC2DC\uB124\uC694\n\uC7A0\uAE50\uB9CC
        \uC774\uC57C\uAE30 \uB098\uB220\uB3C4 \uAD1C\uCC2E\uC744\uAE4C\uC694?"
  - npcId: npc_0001
    dialogueType: Quest_Accept
    questId: Quest_001
    lines:
    - Text: "\uACE0\uB9C8\uC6CC\uC694."
    - Text: "\uCC98\uC74C \uC624\uC2E0 \uBD84\uB4E4\uAED8\uB294\n\uC81C\uAC00 \uAC04\uB2E8\uD788
        \uB9C8\uC744 \uC548\uB0B4\uB97C \uB3C4\uC640\uB4DC\uB9AC\uACE0 \uC788\uC5B4\uC694."
    - Text: "\uC548\uB0B4\uB97C \uC2DC\uC791\uD558\uAE30 \uC804\uC5D0\r\n\uC7A0\uAE50
        \uC900\uBE44\uD560 \uAC8C \uC788\uC5B4\uC11C\uC694.\r\n\uC870\uAE08 \uB4A4\uC5D0
        \uB2E4\uC2DC \uD55C \uBC88 \uB9D0\uC744 \uAC78\uC5B4\uC8FC\uC2DC\uACA0\uC5B4\uC694?"
  - npcId: npc_0001
    dialogueType: Quest_Decline
    questId: Quest_001
    lines:
    - Text: "\uC544\uC27D\uB124\uC694\n\uC0DD\uAC01\uB098\uBA74 \uB2E4\uC2DC \uC640\uC8FC\uC138\uC694"
  - npcId: npc_0001
    dialogueType: Quest_Complete
    questId: Quest_001
    lines:
    - Text: "\uB2E4\uC2DC \uB9D0\uC744 \uAC78\uC5B4\uB2EC\uB77C\uB294 \uC81C \uBD80\uD0C1\n\uC798
        \uC9C0\uCF1C\uC8FC\uC154\uC11C \uC815\uB9D0 \uACE0\uB9C8\uC6CC\uC694."
    - Text: "\uC557!!\n\uC900\uBE44\uC911\uC5D0 \uBE60\uC9C4\uAC8C \uC788\uC5C8\uB124\uC694\n\uB2E4\uC2DC
        \uB9D0\uC744 \uAC78\uC5B4\uC8FC\uC2E4\uC218 \uC788\uC744\uAE4C\uC694?"
  - npcId: npc_0001
    dialogueType: Quest_Offer
    questId: Quest_002
    lines:
    - Text: "\uC88B\uC544\uC694\n\uB9C8\uC744 \uC548\uB0B4 \uC900\uBE44\uAC00 \uB2E4
        \uB418\uC5C8\uC2B5\uB2C8\uB2E4\n\uC2DC\uC791\uD574\uB3C4 \uB420\uAE4C\uC694?"
  - npcId: npc_0001
    dialogueType: Quest_Accept
    questId: Quest_002
    lines:
    - Text: "\uADF8\uB7FC \uC548\uB0B4\uB97C \uC2DC\uC791\uD560\uAC8C\uC694.\r\n\uBA3C\uC800,
        \uC548\uB0B4\uC5D0 \uD544\uC694\uD55C \uAE08\uD654\uB97C \uC870\uAE08 \uB4DC\uB9B4\uAC8C\uC694."
    - Text: "\uC774\uBC29\uC778 \uBD84\uB4E4\uAED8\uB294\r\n\uC624\uB978\uCABD \uC704\uC5D0
        \uC774 \uB9C8\uC744\uC758 \uAD6C\uC870\uAC00 \uBCF4\uC774\uC2E4 \uAC70\uC608\uC694."
    - Text: "\uC9C0\uB3C4\uC5D0\uC11C \uBD81\uCABD\uC744 \uBCF4\uC2DC\uBA74\n\uAE08\uD654
        \uBAA8\uC591\uC774 \uC788\uB294 \uACF3\uC774 \uC788\uC744 \uD150\uB370,\n\uADF8\uACF3\uC5D0
        \uB8E8\uBBF8...\uC0C1\uC810\uC774 \uC788\uC5B4\uC694"
    - Text: "\uBC29\uAE08 \uB4DC\uB9B0 \uAE08\uD654\uB97C \uD314\uC544\uC11C\r\n\uD3EC\uC158
        \uD558\uB098\uB9CC \uC0AC \uC640\uC8FC\uC2E4 \uC218 \uC788\uC744\uAE4C\uC694?"
  - npcId: npc_0001
    dialogueType: Quest_Decline
    questId: Quest_002
    lines:
    - Text: "\uBB54\uAC00 \uD574\uC57C\uD558\uC2E4\uAC8C \uC788\uC73C\uC2E0\uAC00
        \uBCF4\uAD70\uC694"
  - npcId: npc_0001
    dialogueType: Quest_Progress
    questId: Quest_002
    lines:
    - Text: "\uB8E8\uBBF8\uC758 \uC0C1\uC810\uC5D0\uC11C \uD3EC\uC158\uC744 \uC0AC\uC640\uC8FC\uC2DC\uBA74
        \uB429\uB2C8\uB2E4."
  - npcId: npc_0001
    dialogueType: Quest_Complete
    questId: Quest_002
    lines:
    - Text: "\uC0C1\uC810\uC744 \uC774\uC6A9\uD574\uBCF8 \uC18C\uAC10\uC740 \uC5B4\uB5A0\uC2E0\uAC00\uC694?\n\uC774\uAC74
        \uBCF4\uC0C1\uC774\uC5D0\uC694\n\uB2E4\uC74C \uC548\uB0B4\uB3C4 \uC900\uBE44
        \uD574\uB458\uAED8\uC694"
  - npcId: npc_0001
    dialogueType: Quest_Offer
    questId: Quest_003
    lines:
    - Text: "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8, \uB208\uCE58\uCC44\uC168\uB098\uC694?\r\n\uBD80\uD0C1\uC774
        \uC788\uAC70\uB098 \uC77C\uC774 \uB05D\uB098\uBA74\r\n\uC81C \uBA38\uB9AC
        \uC704\uC758 \uD45C\uC2DD\uC774 \uBC14\uB00C\uB294 \uAC78\uC694."
    - Text: "\uC774\uBC29\uC778 \uBD84\uB4E4\uC5D0\uAC90\r\n\uB9C8\uC744\uC758 \uAD6C\uC870\uB098
        \uC800\uD76C \uC0C1\uD0DC \uAC19\uC740 \uAC8C\r\n\uBCF4\uC778\uB2E4\uACE0
        \uB4E4\uC5C8\uC5B4\uC694."
    - Text: "\uC800\uD76C\uC5D0\uAC90 \uC804\uD600 \uBCF4\uC774\uC9C0 \uC54A\uC9C0\uB9CC\uC694\u2026\n\uC870\uAE08
        \uC2E0\uAE30\uD558\uC8E0."
    - Text: "\uC544, \uC774\uC57C\uAE30\uAC00 \uAE38\uC5B4\uC84C\uB124\uC694."
    - Text: "\uB2E4\uC74C \uC548\uB0B4\uB85C,\n\uB9C8\uC744 \uB0A8\uC11C\uCABD\uC758
        \uC57D\uCD08\uBC2D\uC744 \uB458\uB7EC\uBCF4\uB294 \uAC74 \uC5B4\uB5A8\uAE4C\uC694?"
  - npcId: npc_0001
    dialogueType: Quest_Accept
    questId: Quest_003
    lines:
    - Text: "\uC57D\uCD08\uBC2D\uC5D0\uB294 \uC57D\uCD08\uB97C \uBB34\uCC99 \uC88B\uC544\uD558\uB294
        \uB8E8\uBAA8\uAC00 \uC788\uC5B4\uC694.\r\n\uB8E8\uBAA8\uC640\uB3C4 \uD55C
        \uBC88 \uC774\uC57C\uAE30\uD574 \uBCF4\uC138\uC694."
  - npcId: npc_0001
    dialogueType: Quest_Decline
    questId: Quest_003
    lines:
    - Text: "\uB2E4\uB978 \uD560\uC77C\uC774 \uC788\uC73C\uC2E0\uAC74\uAC00\uC694?"
  - npcId: npc_0001
    dialogueType: Quest_Progress
    questId: Quest_003
    lines:
    - Text: "\uB0A8\uC11C\uCABD \uC57D\uCD08\uBC2D\uC5D0 \uC788\uB294 \uB8E8\uBAA8\uC5D0\uC694"
  - npcId: npc_0001
    dialogueType: Quest_Complete
    questId: Quest_003
    lines:
    - Text: "\uC557, \uB8E8\uBAA8\uC758 \uD3B8\uC9C0\uB124\uC694.\r\n\uC7A0\uC2DC
        \uC77D\uC5B4\uBCFC\uAC8C\uC694."
    - Text: ...
    - Text: "\uD6C4\uD6C4\u2026 \uC21C \uC57D\uCD08 \uC774\uC57C\uAE30\uBC16\uC5D0
        \uC5C6\uB124\uC694.\r\n\uB8E8\uBAA8\uAC00 \uC57D\uCD08\uC5D0 \uB300\uD55C
        \uC124\uBA85\uB3C4 \uD574\uC92C\uB098\uC694?\r\n\uC57D\uCD08\uB97C \uB108\uBB34
        \uC88B\uC544\uD558\uB294 \uAC83\uB3C4, \uAC00\uB054\uC740 \uBB38\uC81C\uC608\uC694."
  - npcId: npc_0003
    dialogueType: Normal
    questId: 
    lines:
    - Text: "\uC548\uB155\uD558\uC138\uC694\n\uC57D\uCD08\uB97C \uC88B\uC544\uD558\uC2DC\uB098\uC694?"
  - npcId: npc_0003
    dialogueType: Daily
    questId: 
    lines:
    - Text: "\uC57D\uCD08\uB294 \uBC14\uB77C\uB9CC \uBCF4\uACE0\uC788\uC5B4\uB3C4
        \uD589\uBCF5\uD574\uC838"
  - npcId: npc_0003
    dialogueType: Quest_Offer
    questId: Quest_004
    lines:
    - Text: "\uB8E8\uB8E8\uC5D0\uAC8C\uC11C \uC774\uC57C\uAE30\uB97C \uB4E4\uC5C8\uC5B4\uC694.\r\n\uC57D\uCD08\uC5D0
        \uAD00\uC2EC\uC774 \uC788\uB2E4\uBA74,\r\n\uC7A0\uAE50 \uC774\uC57C\uAE30\uD574
        \uBCFC \uC218 \uC788\uC744\uAE4C\uC694?"
  - npcId: npc_0003
    dialogueType: Quest_Accept
    questId: Quest_004
    lines:
    - Text: "\uC640\uC544~!!\r\n\uC57D\uCD08\uC5D0 \uAD00\uC2EC\uC774 \uC788\uC73C\uC2DC\uAD70\uC694."
    - Text: "\uC0AC\uC2E4 \uC57D\uCD08\uB294\r\n\uC9C1\uC811 \uB2E4\uB904\uBCF4\uB294
        \uAC8C \uC81C\uC77C \uC88B\uC544\uC694."
    - Text: "\uAD1C\uCC2E\uC73C\uC2DC\uB2E4\uBA74,\n\uC8FC\uBCC0\uC5D0\uC11C \uB098\uBB47\uC78E\uB97C\n\uB2E4\uC12F
        \uAC1C\uB9CC \uCE90 \uBCFC\uC218 \uC788\uC744\uAE4C\uC694?"
  - npcId: npc_0003
    dialogueType: Quest_Decline
    questId: Quest_004
    lines:
    - Text: "\uC57D\uCD08...\uC2EB\uC5B4\uD558\uC2DC\uB098\uC694?"
  - npcId: npc_0003
    dialogueType: Quest_Progress
    questId: Quest_004
    lines:
    - Text: "\uB098\uBB47\uC78E 5\uAC1C\uB9CC \uC788\uC73C\uBA74 \uB418\uC694"
  - npcId: npc_0003
    dialogueType: Quest_Complete
    questId: Quest_004
    lines:
    - Text: "\uC0AC\uC2E4 \uC5EC\uAE30 \uC57D\uCD08\uB294 \uBCF4\uB294\uB300\uB85C
        \uADF8\uB0E5 \uB098\uBB47\uC78E\uC774\uC5D0\uC694\n\uB2E4\uB978 \uC9C0\uC5ED\uC5D0\uC11C
        \uB098\uB294 \uC57D\uCD08\uC911\uC5D0\uB294 \uB6F0\uC5B4\uB09C \uD68C\uBCF5
        \uD6A8\uACFC\uAC00 \uC788\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4\uC694"
    - Text: "\uB098\uBB47\uC78E\uC744 \uCE90\uC8FC\uC2DC\uB294 \uB3D9\uC548,\n\uB8E8\uB8E8\uC5D0\uAC8C
        \uC804\uD560 \uD3B8\uC9C0\uC640\n\uBAA8\uD5D8\uAC00\uB2D8\uAED8 \uB4DC\uB9B4
        \uC120\uBB3C\uC744 \uC900\uBE44\uD588\uC5B4\uC694.\n\uACE0\uB9C8\uC6CC\uC694."
  - npcId: npc_0001
    dialogueType: Quest_Offer
    questId: Quest_005
    lines:
    - Text: "\uC557, \uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uC81C\uAC00 \uB9D0\uC744 \uAC78\uC5B4
        \uB2EC\uB77C\uACE0 \uD558\uC9C4 \uC54A\uC558\uB294\uB370,\r\n\uC790\uC5F0\uC2A4\uB7FD\uAC8C
        \uB9D0\uC744 \uAC78\uC5B4\uC8FC\uC168\uB124\uC694."
    - Text: "\uC81C \uC0C1\uD0DC\uB97C \uBCF4\uACE0 \uB9D0\uC744 \uAC70\uC2E0 \uAC74\uAC00\uC694?\r\n\uC544\uB2C8\uBA74\u2026
        \uD639\uC2DC \uC5F0\uD0C0\uD558\uC168\uB098\uC694?"
    - Text: "\uB9C8\uC744 \uB3D9\uCABD\uC5D0 \uACBD\uBE44\uBCD1 \uB8E8\uB77C\uAC00
        \uC788\uC5B4\uC694.\n\uB8E8\uB77C\uC5D0\uAC8C \uC548\uBD80\uB97C \uC804\uD574
        \uC8FC\uC2E4 \uC218 \uC788\uC744\uAE4C\uC694?"
  - npcId: npc_0001
    dialogueType: Quest_Accept
    questId: Quest_005
    lines:
    - Text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4.\r\n\uC544\uB9C8 \uB8E8\uB77C\uB294 \uC804\uD22C\uC5D0
        \uB300\uD55C \uAC78 \uC54C\uB824\uC904 \uAC70\uC608\uC694.\r\n\uC800\uB294
        \uC804\uD22C\uC5D0 \uC18C\uC9C8\uC774 \uC5C6\uC9C0\uB9CC\uC694."
  - npcId: npc_0001
    dialogueType: Quest_Decline
    questId: Quest_005
    lines:
    - Text: "\uB2E4\uB978 \uC77C\uC774 \uC788\uC73C\uC2E0\uAC00\uC694?"
  - npcId: npc_0001
    dialogueType: Quest_Progress
    questId: Quest_005
    lines:
    - Text: "\uB9C8\uC744 \uB3D9\uCABD\uC758 \uB8E8\uB77C\uC5D0\uAC8C \uAC00\uBCF4\uC138\uC694"
  - npcId: npc_0001
    dialogueType: Quest_Complete
    questId: Quest_005
    lines:
    - Text: "\uB8E8\uB77C\uC758 \uD3B8\uC9C0 \uAD70\uC694\n\uC7A0\uC2DC\uB9CC \uC77D\uC5B4\uBCFC\uAED8\uC694"
    - Text: ...
    - Text: "\uD330\uB9AC\uC2A4\uD0C0\uC6B4 \uADFC\uCC98\uC758 \uBAAC\uC2A4\uD130\uB4E4\uC740
        \uC21C\uD558\uB2E4\uACE0 \uC54C\uB824\uC9C0\uAE34 \uD588\uB294\uB370\n\uADF8\uB798\uB3C4
        \uBAAC\uC2A4\uD130\uB97C \uC4F0\uB7EC\uB728\uB9AC\uB2E4\uB2C8 \uB300\uB2E8\uD574\uC694"
  - npcId: npc_0004
    dialogueType: Normal
    questId: 
    lines:
    - Text: "\uC73C...\uC26C\uACE0\uC2F6\uB2E4"
  - npcId: npc_0004
    dialogueType: Daily
    questId: 
    lines:
    - Text: "\uC624\uB298\uB3C4 \uC548\uC804\uD55C\uB370 \uC26C\uC5B4\uB3C4 \uB420\uAE4C..."
  - npcId: npc_0004
    dialogueType: Quest_Offer
    questId: Quest_006
    lines:
    - Text: "\uB8E8\uB8E8\uAC00 \uC548\uBD80\uC778\uC0AC\uB97C \uBCF4\uB0C8\uAD70\uC694\n\uC5EC\uAE30\uB294
        \uD56D\uC0C1 \uD3C9\uD654\uB85C\uC6B4\uB370 \uACBD\uBE44\uAC00 \uD544\uC694\uD560\uAE4C\uC694..."
    - Text: "\uBAA8\uD5D8\uAC00\uB2D8\uC740 \uBB34\uAE30\uB97C \uC548\uB4E4\uACE0
        \uACC4\uC2DC\uB124\uC694\n\uADF8\uB7FC \uB9C8\uC744\uBC16\uC73C\uB85C \uB098\uAC00\uBA74
        \uC704\uD5D8\uD574\uC838\uC694"
    - Text: "\uC81C\uAC00 \uC9E7\uAC8C \uD638\uC2E0\uC220\uC744 \uC54C\uB824\uB4DC\uB9B4\uAED8\uC694"
  - npcId: npc_0004
    dialogueType: Quest_Accept
    questId: Quest_006
    lines:
    - Text: "\uC88B\uC544\uC694 \uC77C\uB2E8 \uBB34\uAE30\uB97C \uB4DC\uB9B4\uAED8\uC694\n\uBB34\uAE30\uB294
        \uAC80\uD558\uACE0 \uC9C0\uD321\uC774\uAC00 \uC788\uC5B4\uC694"
    - Text: "\uAC80\uC744 \uCC29\uC6A9\uD558\uBA74 \uADFC\uAC70\uB9AC \uACF5\uACA9\uC744\n\uC9C0\uD321\uC774\uB97C
        \uCC29\uC6A9\uD558\uBA74 \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC744 \uD560\uC218
        \uC788\uC5B4\uC694"
    - Text: "\uADF8\uB7FC \uC5EC\uAE30\uC11C \uB3D9\uCABD\uC73C\uB85C \uAC00\uBA74
        \uC0C8\uC2F9\uC232\uC774 \uC788\uB294\uB370\n\uC0C8\uC2F9 \uACE0\uC591\uC774
        5\uB9C8\uB9AC\uB9CC \uC7A1\uACE0 \uC640\uC8FC\uC2E4\uC218 \uC788\uC744\uAE4C\uC694?"
  - npcId: npc_0004
    dialogueType: Quest_Decline
    questId: Quest_006
    lines:
    - Text: "\uD638\uC2E0\uC220\uC744 \uC548\uBC30\uC6B0\uBA74 \uB9C8\uC744\uBC16\uC73C\uB85C
        \uAC00\uC2E4\uB54C \uC704\uD5D8\uD574\uC838\uC694"
  - npcId: npc_0004
    dialogueType: Quest_Progress
    questId: Quest_006
    lines:
    - Text: "\uC0C8\uC2F9 \uACE0\uC591\uC774 5\uB9C8\uB9AC \uC785\uB2C8\uB2E4"
  - npcId: npc_0004
    dialogueType: Quest_Complete
    questId: Quest_006
    lines:
    - Text: "\uC624, \uB2E4 \uC7A1\uACE0 \uC624\uC168\uAD70\uC694.\n\uC774 \uC815\uB3C4\uBA74
        \uAE30\uBCF8\uC740 \uC775\uD788\uC2E0 \uAC83 \uAC19\uC544\uC694."
    - Text: "\uC0C8\uC2F9\uC232\uC740 \uB9C8\uC744 \uBC14\uB85C \uC606\uC774\uB77C
        \uC704\uD5D8\uD55C \uB140\uC11D\uB4E4\uC740 \uC5C6\uC5B4\uC694.\n\uADF8\uB798\uB3C4
        \uBC29\uC2EC\uC740 \uAE08\uBB3C\uC785\uB2C8\uB2E4."
    - Text: "\uB8E8\uB8E8\uC5D0\uAC8C \uC904 \uD3B8\uC9C0\uB3C4 \uC791\uC131 \uB2E4
        \uD588\uACE0\n\uC774\uAC74 \uBC29\uAE08 \uC0C8\uC2F9 \uACE0\uC591\uC774\uB97C
        \uC7A1\uC544\uC8FC\uC2E0 \uB2F5\uB840\uC785\uB2C8\uB2E4.\n\uB8E8\uB8E8\uC5D0\uAC8C
        \uC548\uBD80 \uC804\uD574\uC8FC\uC138\uC694"
  - npcId: npc_0001
    dialogueType: Quest_Offer
    questId: Quest_007
    lines:
    - Text: "\uADF8\uB7EC\uACE0\uBCF4\uB2C8 \uB8E8\uB77C\uAC00 \uC2A4\uD0AC\uC2A4\uD06C\uB864\uC744
        \uC92C\uB2E4\uACE0 \uD558\uB358\uB370\n\uC774\uBBF8 \uC0AC\uC6A9\uD558\uC168\uB098\uC694?"
    - Text: "\uC2A4\uD0AC\uC744 \uBC30\uC6B0\uC168\uC73C\uBA74 \uC0AC\uC6A9\uD574\uBCF4\uACE0
        \uC2F6\uC73C\uC2E4\uAC70 \uAC19\uC740\uB370\n\uC0C8\uC2F9 \uACE0\uC591\uC774
        10\uB9C8\uB9AC\uB9CC \uC7A1\uACE0 \uC640\uC8FC\uC2E4\uC218 \uC788\uB098\uC694?"
  - npcId: npc_0001
    dialogueType: Quest_Accept
    questId: Quest_007
    lines:
    - Text: "\uC2A4\uD0AC\uC774 \uC788\uC73C\uB2C8 \uAE08\uBC29 \uC7A1\uC73C\uC2E4\uC218
        \uC788\uC744\uAEBC\uC5D0\uC694"
  - npcId: npc_0001
    dialogueType: Quest_Decline
    questId: Quest_007
    lines:
    - Text: "10\uB9C8\uB9AC\uB294 \uBD80\uB2F4\uC2A4\uB7EC\uC6B4\uAC00\uC694,,,"
  - npcId: npc_0001
    dialogueType: Quest_Progress
    questId: Quest_007
    lines:
    - Text: "\uC0C8\uC2F9 \uACE0\uC591\uC774 10\uB9C8\uB9AC\uC5D0\uC694\n\uD798\uB0B4\uC138\uC694"
  - npcId: npc_0001
    dialogueType: Quest_Complete
    questId: Quest_007
    lines:
    - Text: "\uAE08\uBC29 \uB2E4\uB140\uC624\uC168\uB124\uC694\n\uC800\uB3C4 \uC2A4\uD0AC
        \uC2A4\uD06C\uB864 \uD558\uB098\uB97C \uC120\uBB3C\uD574\uB4DC\uB9B4\uAED8\uC694"
    - Text: "\uC81C\uAC00 \uC548\uB0B4 \uD574\uB4DC\uB9B4\uC218 \uC788\uB294\uAC74
        \uB2E4 \uD55C\uAC70 \uAC19\uC544\uC694"
    - Text: "\uB2E4\uB140\uC624\uC2DC\uB294\uB3D9\uC548 \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C
        \uC18C\uC2DD\uC744 \uC804\uD588\uB354\uB2C8\n\uB2E4\uB4E4 \uBD80\uD0C1\uD560\uAC8C\uC788\uB2E4\uACE0
        \uD558\uB354\uB77C\uACE0\uC694"
    - Text: "\uAC00\uB2A5\uD558\uC2DC\uB2E4\uBA74 \uB9C8\uC744\uC0AC\uB78C\uB4E4\uC758
        \uBD80\uD0C1\uC744 \uB4E4\uC5B4\uC904\uC218 \uC788\uC744\uAE4C\uC694?"
    - Text: "\uB9C8\uC744\uC0AC\uB78C\uB4E4\uC758 \uBD80\uD0C1\uC740 \uB808\uBCA8\uC5D0\uB530\uB77C,\uC544\uC774\uD15C\uC18C\uC9C0\uC5D0
        \uB530\uB77C\n\uC0DD\uAE38\uC218\uB3C4 \uC788\uC5B4\uC694"
  - npcId: npc_0007
    dialogueType: Normal
    questId: 
    lines:
    - Text: "\uC548\uB155\uD558\uC138\uC694"
  - npcId: npc_0007
    dialogueType: Daily
    questId: 
    lines:
    - Text: "\uBAAC\uC2A4\uD130\uB4E4\uC740 \uB9C8\uB098\uB369\uC5B4\uB9AC \uC778\uB370
        \uC8FD\uC744\uB54C \uC65C \uC544\uC774\uD15C\uC744 \uB5A8\uC5B4\uB728\uB9B4\uAE4C\uC694?"
  - npcId: npc_0008
    dialogueType: Normal
    questId: 
    lines:
    - Text: "\uD3A0\uB9AC\uC2A4\uD0C0\uC6B4\uC740 \uC9C0\uC5B4\uC9C4\uC9C0 \uC5BC\uB9C8
        \uC548\uB42C\uB2E4\uB098\uBD10\uC694"
  - npcId: npc_0008
    dialogueType: Daily
    questId: 
    lines:
    - Text: "\uC6D0\uB798\uB294 \uADF8\uB0E5 \uACF5\uD130\uC778\uB370 \uC911\uC559\uD5C8\uBE0C\uB85C\uC11C
        \uB9C8\uC744\uC744 \uC9C0\uC5C8\uB2E4\uB098\uBD10\uC694"
  - npcId: npc_0009
    dialogueType: Normal
    questId: 
    lines:
    - Text: "\uC2A4\uD0AC\uC2A4\uD06C\uB864\uC744 \uC0AC\uC6A9\uD574\uBCF4\uC168\uB098\uC694?"
  - npcId: npc_0009
    dialogueType: Daily
    questId: 
    lines:
    - Text: "\uC774\uBBF8 \uBC30\uC6B4\uC2A4\uD0AC\uC758 \uC2A4\uD0AC\uC2A4\uD06C\uB864\uC740
        \uC0AC\uC6A9\uD574\uB3C4 \uC544\uBB34\uC77C\uB3C4 \uC548\uC77C\uC5B4\uB09C\uB300\uC694"
  - npcId: npc_0010
    dialogueType: Normal
    questId: 
    lines:
    - Text: "\uC218\uB828\uC744 \uAC8C\uC744\uB9AC \uD558\uBA74 \uC548\uB418\uC694"
  - npcId: npc_0010
    dialogueType: Daily
    questId: 
    lines:
    - Text: "\uADFC\uB370 \uD3A0\uB9AC\uC2A4\uD0C0\uC6B4\uC740 \uD3C9\uD654\uB85C\uC6B4\uB370..."
  - npcId: npc_0012
    dialogueType: Normal
    questId: 
    lines:
    - Text: "\uC774 \uC12C\uC5D0\uB294 \uB9C8\uB098\uAC00 \uD48D\uBD80\uD574\uC694"
  - npcId: npc_0012
    dialogueType: Daily
    questId: 
    lines:
    - Text: "\uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD558\uB824 \uD574\uB3C4 \uC12C\uC758
        \uB9C8\uB098\uB97C \uC774\uC6A9\uD558\uC8E0"
  - npcId: npc_0013
    dialogueType: Normal
    questId: 
    lines:
    - Text: "\uC9C4\uB85C\uB294 \uD56D\uC0C1 \uACE0\uBBFC\uC774 \uB418\uB294 \uC77C\uC774\uC8E0"
  - npcId: npc_0013
    dialogueType: Daily
    questId: 
    lines:
    - Text: "\uB2F9\uC2E0\uC758 \uC9C4\uB85C\uB294 \uC815\uD574\uC838\uC788\uB098\uC694?"
  - npcId: npc_0007
    dialogueType: Quest_Offer
    questId: Quest_008
    lines:
    - Text: "\uB9C8\uB098\uB369\uC5B4\uB9AC\uC778 \uBAAC\uC2A4\uD130\uAC00 \uC544\uC774\uD15C\uC744
        \uB5A8\uC5B4\uB728\uB9AC\uB294\uAC8C \uC2E0\uACBD\uC4F0\uC5EC\uC694\n\uC800\uB97C
        \uB3C4\uC640 \uC8FC\uC2E4 \uC218 \uC788\uC744\uAE4C\uC694?"
  - npcId: npc_0007
    dialogueType: Quest_Accept
    questId: Quest_008
    lines:
    - Text: "\uB3D9\uCABD\uC232\uC5D0 \uC0AC\uB294 \uBAAC\uC2A4\uD130\uB4E4\uC740
        \uBAA8\uB450 \uB9C8\uB098\uB369\uC5B4\uB9AC\uB97C \uB5A8\uC5B4\uB728\uB9AC\uB294\uB370\n5\uAC1C\uB9CC
        \uAD6C\uD574\uC8FC\uC2E4\uC218 \uC788\uC744\uAE4C\uC694?"
  - npcId: npc_0007
    dialogueType: Quest_Decline
    questId: Quest_008
    lines:
    - Text: "\uC2E0\uACBD\uC4F0\uC774\uC9C0 \uC54A\uB294\uAC74\uAC00\uC694?"
  - npcId: npc_0007
    dialogueType: Quest_Progress
    questId: Quest_008
    lines:
    - Text: "\uB9C8\uB098\uB369\uC5B4\uB9AC 5\uAC1C\uB9CC \uAD6C\uD574\uC8FC\uC138\uC694"
  - npcId: npc_0007
    dialogueType: Quest_Complete
    questId: Quest_008
    lines:
    - Text: "\uBAAC\uC2A4\uD130\uAC00 \uC8FD\uC73C\uBA74\uC11C \uBB49\uCCD0\uC9C4
        \uB9C8\uB098\uB369\uC5B4\uB9AC\uAC00\n\uD658\uACBD\uC5D0 \uB530\uB77C \uC544\uC774\uD15C\uC73C\uB85C
        \uBCC0\uD55C\uB2E4\uACE0 \uC54C\uB824\uC838 \uC788\uC5B4\uC694"
  - npcId: npc_0009
    dialogueType: Quest_Offer
    questId: Quest_009
    lines:
    - Text: "\uBC30\uC6B0\uC2E0 \uC2A4\uD0AC\uC774 \uC788\uC73C\uC2E0\uAC00\uC694?\n\uBAAC\uC2A4\uD130\uB97C
        \uD5A5\uD574 \uC368\uBCF4\uACE0 \uC2F6\uC9C0 \uC54A\uC73C\uC2E0\uAC00\uC694?"
  - npcId: npc_0009
    dialogueType: Quest_Accept
    questId: Quest_009
    lines:
    - Text: "\uB9C8\uC744\uC815\uD654\uB3C4 \uD560\uACB8\n\uB4E4\uAF43 \uACE0\uC591\uC774\uB97C
        10\uB9C8\uB9AC\uB97C \uC7A1\uACE0 \uC640\uC8FC\uC138\uC694"
  - npcId: npc_0009
    dialogueType: Quest_Decline
    questId: Quest_009
    lines:
    - Text: "\uC544...\uBCC4\uB85C \uC4F0\uACE0 \uC2F6\uC9C0 \uC54A\uC73C\uC2DC\uAD6C\uB098"
  - npcId: npc_0009
    dialogueType: Quest_Progress
    questId: Quest_009
    lines:
    - Text: "\uBAAC\uC2A4\uD130\uB97C \uD5A5\uD574 \uD30C\uBC14\uBC15~\n\uB4E4\uAF43
        \uACE0\uC591\uC774\uB97C \uCC98\uCE58\uD574\uC8FC\uC138\uC694\n\uAE4A\uC740\uC232\uC5D0
        \uB9CE\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4\uC694"
  - npcId: npc_0009
    dialogueType: Quest_Complete
    questId: Quest_009
    lines:
    - Text: "\uC0C1\uCF8C\uD55C\uB290\uB08C\uC774 \uB4E4\uC5B4\uC694\n\uBAAC\uC2A4\uD130\uB97C
        \uB9CE\uC774 \uCC98\uCE58 \uD574\uC8FC\uC168\uAD70\uC694"
  - npcId: npc_0010
    dialogueType: Quest_Offer
    questId: Quest_010
    lines:
    - Text: "\uC218\uB828\uC744 \uC88B\uC544\uD558\uC2DC\uB098\uC694?\n\uB098\uBB47\uC78E
        \uACE0\uC591\uC774\uB97C 10\uB9C8\uB9AC\uB97C \uC7A1\uC544\uC640\uC8FC\uC2E4\uC218
        \uC788\uB098\uC694?"
  - npcId: npc_0010
    dialogueType: Quest_Accept
    questId: Quest_010
    lines:
    - Text: "\uB098\uBB47\uC78E \uACE0\uC591\uC774\uB97C \uC7A1\uACE0 \uB098\uBB47\uC78E\uB3C4
        5\uAC1C\uB9CC \uAD6C\uD574\uC8FC\uC138\uC694"
    - Text: "\uB098\uBB47\uC78E\uC740 \uB098\uBB47\uC78E \uACE0\uC591\uC774\uAC00
        \uC8FC\uAE30\uB3C4 \uD558\uC9C0\uB9CC \uC57D\uCD08\uBC2D\uC5D0\uC11C\uB3C4
        \uAD6C\uD560\uC218 \uC788\uC5B4\uC694"
  - npcId: npc_0010
    dialogueType: Quest_Decline
    questId: Quest_010
    lines:
    - Text: "\uC5ED\uC2DC \uC218\uB828\uD560 \uC774\uC720\uAC00 \uC5C6\uAE34 \uD558\uC8E0..."
  - npcId: npc_0010
    dialogueType: Quest_Progress
    questId: Quest_010
    lines:
    - Text: "\uB098\uBB47\uC78E \uACE0\uC591\uC774 10\uB9C8\uB9AC\uC640 \uB098\uBB47\uC78E
        5\uAC1C\uC5D0\uC694"
  - npcId: npc_0010
    dialogueType: Quest_Complete
    questId: Quest_010
    lines:
    - Text: "\uAC15\uD558\uC2DC\uB124\uC694\n\uC800\uB3C4 \uAC15\uD574\uC9C0\uBA74
        \uB354 \uB113\uC740 \uC138\uC0C1\uC744 \uBCF4\uACE0 \uC2F6\uC5B4\uC694"
  - npcId: npc_0012
    dialogueType: Quest_Offer
    questId: Quest_011
    lines:
    - Text: "\uD478\uB978\uC232\uC740 \uB9C8\uB098\uAC00 \uD48D\uBD80\uD574\uC11C
        \uC57D\uCD08\uAC00 \uC790\uB77C\uB09C\uB2E4\uACE0 \uB4E4\uC5C8\uB294\uB370\n\uC57D\uCD08\uB97C
        \uCE90\uC640\uC8FC\uC2E4\uC218 \uC788\uB098\uC694?"
  - npcId: npc_0012
    dialogueType: Quest_Accept
    questId: Quest_011
    lines:
    - Text: "\uB8E8\uBAA8\uD55C\uD14C\uB3C4 \uC120\uBB3C\uD574\uC904\uC218 \uC788\uAC8C
        10\uAC1C \uBD80\uD0C1\uB4DC\uB824\uC694"
  - npcId: npc_0012
    dialogueType: Quest_Decline
    questId: Quest_011
    lines:
    - Text: "\uBC14\uC058\uC2E0\uAC00\uBCF4\uB124\uC694"
  - npcId: npc_0012
    dialogueType: Quest_Progress
    questId: Quest_011
    lines:
    - Text: "\uD478\uB978\uC232\uC5D0\uC11C \uB098\uB294 \uC57D\uCD08 10\uAC1C\uC5D0\uC694"
  - npcId: npc_0012
    dialogueType: Quest_Complete
    questId: Quest_011
    lines:
    - Text: "\uCCB4\uB825\uC774 \uD68C\uBCF5\uB418\uB294 \uB290\uB08C\uC774 \uB4DC\uB124\uC694\n\uB9C8\uB098\uB97C
        \uBA38\uAE08\uACE0 \uC788\uB098\uBD10\uC694"
  - npcId: npc_0003
    dialogueType: Quest_Offer
    questId: Quest_012
    lines:
    - Text: "\uBBF8\uB8E8\uD55C\uD14C \uB4E4\uC5C8\uC5B4\uC694\n\uC57D\uCD08\uB97C
        \uB354 \uAD6C\uD574\uC8FC\uC2E4\uC218 \uC788\uC744\uAE4C\uC694?"
  - npcId: npc_0003
    dialogueType: Quest_Accept
    questId: Quest_012
    lines:
    - Text: "\uC57D\uCD08 15\uAC1C \uBD80\uD0C1\uB4DC\uB824\uC694"
  - npcId: npc_0003
    dialogueType: Quest_Decline
    questId: Quest_012
    lines:
    - Text: "\uC81C\uAC00 \uAC00\uACE0 \uC2F6\uC9C0\uB9CC \uC800\uB294 \uC804\uD22C\uB97C
        \uBABB\uD574\uC694..."
  - npcId: npc_0003
    dialogueType: Quest_Progress
    questId: Quest_012
    lines:
    - Text: "\uC57D\uCD08 15\uAC1C \uBD80\uD0C1\uB4DC\uB824\uC694"
  - npcId: npc_0003
    dialogueType: Quest_Complete
    questId: Quest_012
    lines:
    - Text: "\uC640\uC544 \uC57D\uCD08...\uB108\uBB34 \uC88B\uC544..."
  - npcId: npc_0013
    dialogueType: Quest_Offer
    questId: Quest_013
    lines:
    - Text: "\uB2F9\uC2E0\uC740 \uAC15\uD574\uBCF4\uC774\uC2DC\uB124\uC694\n\uADF8\uB7F0\uB370
        \uC544\uC9C1 \uC815\uD558\uC9C0 \uC54A\uC740\uAC8C \uC788\uC5B4\uBCF4\uC5EC\uC694"
    - Text: "\uC815\uD560\uC218 \uC788\uAC8C \uC81C\uAC00 \uB3C4\uC640\uB4DC\uB9B4\uAED8\uC694"
  - npcId: npc_0013
    dialogueType: Quest_Accept
    questId: Quest_013
    lines:
    - Text: "\uC88B\uC544\uC694\n\uADF8\uB7FC \uC77C\uB2E8 \uC2E4\uB825\uC744 \uD655\uC778\uD574\uBCF4\uAE30
        \uC704\uD574\n\uC232\uC758 \uACE0\uC591\uC774\uB97C \uC7A1\uACE0 \uC232\uC758
        \uB9C8\uB098 \uB369\uC5B4\uB9AC\uB97C \uAC00\uC838\uC640\uC8FC\uC138\uC694"
  - npcId: npc_0013
    dialogueType: Quest_Decline
    questId: Quest_013
    lines:
    - Text: "\uC544\uC9C1 \uACE0\uBBFC\uC911\uC774\uC2E0\uAC00\uC694?"
  - npcId: npc_0013
    dialogueType: Quest_Progress
    questId: Quest_013
    lines:
    - Text: "\uC232\uC758 \uACE0\uC591\uC774 1\uB9C8\uB9AC\uC640 \uC232\uC758 \uB9C8\uB098
        \uB369\uC5B4\uB9AC 1\uAC1C \uC785\uB2C8\uB2E4"
  - npcId: npc_0013
    dialogueType: Quest_Complete
    questId: Quest_013
    lines:
    - Text: "\uB2E4\uC2DC \uC800\uC5D0\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC120\uD0DD
        \uD574\uBCF4\uC138\uC694"
  - npcId: npc_0001
    dialogueType: Quest_Offer
    questId: Quest_014
    lines:
    - Text: "\uC5B4\uB77C? \uC6B0\uD45C\uB97C \uBC1B\uC544\uC624\uC168\uB124\uC694"
    - Text: "\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC740 \uAC10\uC0AC\uC758 \uD45C\uC2DC\uB85C
        \uC6B0\uD45C\uB97C \uC904\uAEBC\uC5D0\uC694"
    - Text: "\uADF8\uB7EC\uACE0\uBCF4\uB2C8 \uC800\uB3C4 \uB9CE\uC774 \uB3C4\uC640\uC8FC\uC168\uC73C\uB2C8
        \uC6B0\uD45C\uB97C \uB4DC\uB9B4\uAED8\uC694"
  - npcId: npc_0001
    dialogueType: Quest_Accept
    questId: Quest_014
    lines:
